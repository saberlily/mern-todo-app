# MONGO_URI changes depending on where the backend runs.
# If the password contains special characters (@ : / ? # % etc.), URL-encode
# them (e.g. via encodeURIComponent) so the connection string parses correctly
# — this matters most on the VPS, where MongoDB's port is exposed publicly.

# Local (MongoDB running on your machine, backend run directly with `node server.js`)
# MONGO_URI=mongodb://admin:your_password@localhost:27017/todo?authSource=admin

# Docker (backend + mongodb both run via docker-compose, reached by service name)
# MONGO_URI=mongodb://admin:your_password@mongodb:27017/todo?authSource=admin

# VPS (MongoDB port is published publicly, so the password must be URL-encoded)
MONGO_URI=mongodb://admin:your_url_encoded_password@<vps-ip>:27017/todo?authSource=admin

GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password
PORT=8000
JWT_SECRET=your_jwt_secret
